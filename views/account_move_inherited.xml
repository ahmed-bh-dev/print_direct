  <record id="view_invoice_button_inherited" model="ir.ui.view">
    <field name="name">invoice.form.inherited.with.button</field>
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_move_form"/>
    <field name="arch" type="xml">
        <xpath expr="//header" position="inside">
            <button name="print_report"
                    type="object"
                    class="btn-primary"
                    string="Print Invoice"
                    groups="Matrix_Invoice_Printer_one.group_report_once"
                    invisible="(print_count > 0)"/>
        </xpath>
    </field>
</record>





